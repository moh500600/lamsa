# انسخ هذا الملف إلى .env للتطوير المحلي فقط.
# لا تضع هذا الملف أو أي قيم حقيقية داخل Git أو داخل الواجهة.

# تشغيل محلي مريح للمعاينة فقط. عطّله في الإنتاج.
DEMO_MODE=true
PORT=3000

# يحقنه WebDev تلقائيًا عند تفعيل قاعدة البيانات المُدارة؛ لا تستبدله يدويًا.
DATABASE_URL=

# تكامل Google Business Profile الرسمي — الخادم فقط
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# الذكاء الاصطناعي الخارجي اختياري. في WebDev يفضّل استخدام Manus LLM المدمج عبر MANUS_API_URL.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Manus OAuth — يحقنها WebDev تلقائيًا، لا تضعها في Flutter/React.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=
